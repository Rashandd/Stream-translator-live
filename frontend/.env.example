# StreamDubber frontend — örnek ortam değişkenleri.
# Kopyala: cp .env.example .env.local (gerçek .env.local asla commit edilmez)
#
# KRİTİK: Production'da bu ikisi backend'in KENDİ domain'ine (api.strovak.com)
# gitmeli — Railway'deki frontend servisi ASLA API/ses trafiğini proxy'lemez.
# Tüm fetch/WebSocket çağrıları tarayıcıdan (client component) doğrudan bu
# URL'lere gider (bkz. src/lib/api.ts, infra/railway.md "KRİTİK KURAL").
# Production değeri: NEXT_PUBLIC_API_URL=https://api.strovak.com
#                     NEXT_PUBLIC_OVERLAY_WS_URL=wss://api.strovak.com

# Overlay sayfasının (OBS Browser Source, /o/[token]) bağlandığı backend WS tabanı.
NEXT_PUBLIC_OVERLAY_WS_URL=ws://localhost:8080

# Admin panel ve dashboard'un konuştuğu backend HTTP tabanı (login, /admin/secrets, ...).
NEXT_PUBLIC_API_URL=http://localhost:8080
