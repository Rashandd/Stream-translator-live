**/claude.md

# Runtime configuration and secrets never belong in an image context.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.npmrc
**/.npmrc
*.pem
**/*.pem
*.key
**/*.key
*.crt
**/*.crt
*.pfx
**/*.pfx
*.p12
**/*.p12
*.der
**/*.der
*.enc
**/*.enc
google-client-secret.json
**/google-client-secret.json
twitch-keys
**/twitch-keys

# Host build products and dependency trees.
node_modules/
**/node_modules/
target/
**/target/
.next/
**/.next/
out/
**/out/
dist/
**/dist/
coverage/
**/coverage/
*.tsbuildinfo

# Local state and transient output.
*.log
*.tmp
*.sqlite
*.sqlite3
*.db
.cache/
**/.cache/
.docker/
