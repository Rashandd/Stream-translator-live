# Copy only to /etc/streamdubber/staging.env, owned by root with mode 0600.
# Do not place real values in the repository.
POSTGRES_DB=streamdubber_staging
POSTGRES_USER=streamdubber
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
# Exactly 32 random bytes encoded as 64 lowercase hex characters.
SECRETS_ENC_KEY=replace-with-64-hex-characters

# Required before an operator can sign in and enter staging-only provider/OAuth
# credentials. Generate the hash with: cargo run --bin hash_password
ADMIN_EMAIL=staging-operator@example.com
# Single quotes are required so Compose preserves the PHC dollar signs.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace-salt$replace-hash'
