# StreamDubber — örnek ortam değişkenleri.
# Kopyala: cp .env.example .env  (gerçek .env asla commit edilmez)

# --- Backend sunucu ---
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- Merkezi log deposu (Faz 1.12) ---
# Kalıcı JSONL log dosyası (admin /admin/logs buradan okur). Boşsa bellek içi
# çalışır (restart'ta kaybolur) — üretimde set edilmeli. Asgari seviye env değil,
# `log.level` config anahtarından (admin panel, restart gerektirmez) okunur.
LOG_FILE=

# --- Kullanım sayaçları (Faz 1.11) ---
# Kalıcı JSONL kullanım dosyası (plan limiti sayaçları restart'a dayanır).
# Boşsa bellek içi (restart'ta sıfırlanır). DATABASE_URL varsa ayrıca
# usage_records tablosuna dakika bazında upsert edilir.
USAGE_FILE=

# --- Yerel STT ayarları (Faz 2.6b) ---
# Kullanıcı başına STT modu (cloud/local) + son donanım testi sonucu.
# Düz JSON (secret içermez). Boşsa bellek içi (restart'ta varsayılana döner).
STT_SETTINGS_FILE=

# --- "Founding 5" kapalı beta başvuruları ---
# Yayıncı başvuruları + admin onay durumu (founding.gate.enabled kapısı
# bunu okur). Düz JSON (kanal linki secret değil). Boşsa bellek içi —
# restart'ta başvurular VE onaylar kaybolur, betada mutlaka set et.
FOUNDING_APPS_FILE=

# --- Veritabanı / cache ---
DATABASE_URL=postgres://streamdubber:streamdubber@postgres:5432/streamdubber
REDIS_URL=redis://redis:6379

# --- Secret / key yönetimi ---
# VARSAYILAN: env-based secret store (aşağıdaki JWT_SECRET / *_KEY doğrudan okunur).
JWT_SECRET=change-me-in-production-min-32-bytes-secret
#
# ADMIN PANEL KATMANI: Sağlayıcı key'leri deploy sonrası admin panelden
# (PUT /admin/secrets/{AD}) girilebilir ve restart GEREKMEDEN devreye girer.
# Panel key'leri sadece maskeli okur (baş+son, ör. sk_l…3456) — tam değer dönmez.
# SECRETS_FILE: panelden girilen secret'ların AES-256-GCM şifreli kalıcı dosyası.
# Boş bırakılırsa panel girişleri restart'ta kaybolur (dev/CI kabul edilebilir).
SECRETS_FILE=
# TOKENS_FILE: OAuth token'larının (Streamlabs/YouTube) AES-256 şifreli kalıcı
# dosyası. Boşsa bağlantılar restart'ta düşer (yeniden bağlanmak gerekir).
TOKENS_FILE=
# RELAY_FILE: SDK relay hedeflerinin (RTMP URL + stream key) AES-256 şifreli
# kalıcı dosyası. Boşsa hedefler restart'ta yeniden girilir.
RELAY_FILE=
# SDK_SESSIONS_FILE: eşleşmiş cihazların canlı presence kaydının (heartbeat
# secret + cihaz adı) AES-256 şifreli kalıcı dosyası. Boşsa panelin "bağlı
# cihazlar" listesi restart'ta sıfırlanır (device JWT'ler yine de 30 gün
# geçerli kalır — sadece canlı durum/liste kaybolur).
SDK_SESSIONS_FILE=
# USERS_FILE: yayıncı hesaplarının (1.4) AES-256 şifreli kalıcı dosyası.
# Boşsa hesaplar restart'ta kaybolur (dev/CI). DATABASE_URL varsa kayıtlar
# ayrıca users tablosuna best-effort yansıtılır.
USERS_FILE=
# STT_SERVERS_FILE: self-hosted GPU STT sunucu kayıtlarının (roadmap 2.6 —
# SSH private key + API token dahil) AES-256 şifreli kalıcı dosyası. Boşsa
# kayıtlar restart'ta kaybolur (dev/CI) — admin sunucuları yeniden ekleyip
# kurmak zorunda kalır. Bkz. docs/selfhosted-stt-plan.md.
STT_SERVERS_FILE=
# STT_BOOTSTRAP_SCRIPT: infra/stt-server/bootstrap.sh'in yolu — SshProvisioner
# admin bir sunucuyu "kur"duğunda bunu SSH üzerinden uzak makinede çalıştırır.
# Docker image'ında /app/infra/stt-server/bootstrap.sh'e gömülü (varsayılan).
# Okunamazsa provisioning açık bir hatayla başarısız olur, backend çökmez.
STT_BOOTSTRAP_SCRIPT=
# STT_APP_DIR: stt-server/main.py + requirements.txt'in bulunduğu dizin.
# SshProvisioner bunları her provision çağrısında uzak makineye yazar —
# Docker kullanılamayan hedeflerde (ör. Vast.ai'nin varsayılan container
# instance tipi — nested Docker/systemd yok) bootstrap.sh bunları doğrudan
# bir Python venv'de çalıştırır ("bare mode"). Docker image'ında
# /app/stt-server'a gömülü (varsayılan).
STT_APP_DIR=
# SECRETS_ENC_KEY: 32 byte (64 hex veya base64). Boşsa anahtar JWT_SECRET'tan
# türetilir — o durumda JWT_SECRET değişirse dosya açılamaz, yeniden girilir.
SECRETS_ENC_KEY=

# --- CORS (dashboard/panel) ---
# Frontend'in origin'leri (virgülle ayrılmış). Frontend Vercel'de, API ayrı
# host'ta olduğundan tarayıcı istekleri cross-origin'dir — preflight bu
# listeye göre yanıtlanır. Boşsa varsayılan http://localhost:3000 ve
# http://127.0.0.1:3000 (dev).
# Örn: https://strovak.com,https://www.strovak.com
CORS_ALLOWED_ORIGINS=

# --- Bootstrap admin (panel girişi) ---
# Kullanıcı sistemi (1.4) gelene kadar tek admin env'den tanımlanır.
# ADMIN_PASSWORD_HASH üretmek için: cargo run --bin hash_password
# (argon2id PHC dizesi basar). İkisi de boşsa admin login 503 döner.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# SADECE dev: düz şifre (hash yerine). Üretimde kullanma — startup warn loglar.
#ADMIN_PASSWORD=
#
# VAULT: Aşağıdaki ikisi de set edilirse backend secret'ları Vault KV v2'den çeker
# (GET {VAULT_ADDR}/v1/{VAULT_MOUNT}/data/{NAME} → .data.data.value).
# ÖNEMLİ: Vault'u açmadan önce secret'ları Vault'a seed etmelisin (JWT_SECRET,
# DEEPGRAM_KEY, DEEPL_KEY ...), yoksa backend açılışta secret bulamayıp durur.
# Local dev için yorumda bırak → env kullanılır.
#VAULT_ADDR=http://vault:8200
#VAULT_TOKEN=dev-root-token
#VAULT_MOUNT=secret

# --- TLS 1.3 (+ mTLS) ---
# Üçü de boşsa backend düz HTTP çalışır (reverse-proxy TLS terminasyonu).
# Dev sertifikaları: bash infra/tls/gen-dev-certs.sh
TLS_CERT_PATH=
TLS_KEY_PATH=
# mTLS için istemci CA'sı (SDK ↔ bulut karşılıklı doğrulama). Boşsa mTLS kapalı.
TLS_CLIENT_CA_PATH=

# --- SMTP (2FA/işlem mailleri, Faz 1.4 hazırlığı) ---
# Hepsi admin panelden de girilebilir (Admin > Secrets) — env zorunlu değil.
# TLS kipi config'ten: mail.smtp.tls = starttls (varsayılan) | none.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# --- Sağlayıcı API key'leri (Vault'tan çekilir, koda gömülmez) ---
DEEPGRAM_KEY=
ASSEMBLYAI_KEY=
DEEPL_KEY=
GOOGLE_TRANSLATE_KEY=
ELEVENLABS_KEY=

# --- Multistream/platform OAuth istemci kimlikleri (Faz 1.6/1.10) ---
# Boşsa ilgili sağlayıcı "yapılandırılmamış" görünür; authorize 503 döner.
STREAMLABS_CLIENT_ID=
STREAMLABS_CLIENT_SECRET=
# YouTube (Native CC, Faz 1.10): Google Cloud Console > OAuth 2.0 Client IDs.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Login ile giriş (Faz 2.9) ---
# Boşsa ilgili "Continue with X" butonu 503 döner (start ucu).
# GOOGLE_LOGIN_CLIENT_ID/SECRET: yukarıdaki YOUTUBE_CLIENT_ID'den BİLİNÇLİ
# olarak ayrı bir Google Cloud Console client'ı (login minimal openid/email
# scope'u ister, YouTube captions ise kanal yönetimi scope'u — karıştırılmaz).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Twitch Developer Console > Register Your Application. TWITCH_EXT_SECRET'tan
# (Twitch Extension EBS shared secret'ı, admin panelden girilir) ayrı — bu bir OAuth client.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Stripe (Faz 1.11) ---
# Boşsa checkout/webhook "yapılandırılmamış" (503) döner.
# STRIPE_SECRET_KEY: Stripe Dashboard > Developers > API keys (sk_test_... / sk_live_...)
# STRIPE_WEBHOOK_SECRET: Stripe Dashboard > Developers > Webhooks > İlgili endpoint (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Altyapı / deploy (opsiyonel) ---
RAILWAY_TOKEN=
# HETZNER_API_KEY: kullanılmıyor — self-hosted GPU STT (roadmap 2.6) VM'i
# otomatik oluşturmaz, admin GPU'lu VPS/VDS'i (hangi sağlayıcıdan olursa
# olsun) elle açar, backend sadece SSH ile bağlanıp yazılımı kurar. Bkz.
# docs/selfhosted-stt-plan.md.
HETZNER_API_KEY=
