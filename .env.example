# StreamDubber — örnek ortam değişkenleri.
# Kopyala: cp .env.example .env  (gerçek .env asla commit edilmez)

# --- Backend sunucu ---
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- Veritabanı / cache ---
DATABASE_URL=postgres://streamdubber:streamdubber@postgres:5432/streamdubber
REDIS_URL=redis://redis:6379

# --- Secret / key yönetimi ---
# VARSAYILAN: env-based secret store (aşağıdaki JWT_SECRET / *_KEY doğrudan okunur).
JWT_SECRET=change-me-in-production-min-32-bytes-secret
#
# VAULT: Aşağıdaki ikisi de set edilirse backend secret'ları Vault KV v2'den çeker
# (GET {VAULT_ADDR}/v1/{VAULT_MOUNT}/data/{NAME} → .data.data.value).
# ÖNEMLİ: Vault'u açmadan önce secret'ları Vault'a seed etmelisin (JWT_SECRET,
# DEEPGRAM_KEY, DEEPL_KEY ...), yoksa backend açılışta secret bulamayıp durur.
# Local dev için yorumda bırak → env kullanılır.
#VAULT_ADDR=http://vault:8200
#VAULT_TOKEN=dev-root-token
#VAULT_MOUNT=secret

# --- TLS 1.3 (+ mTLS) ---
# Üçü de boşsa backend düz HTTP çalışır (reverse-proxy TLS terminasyonu).
# Dev sertifikaları: bash infra/tls/gen-dev-certs.sh
TLS_CERT_PATH=
TLS_KEY_PATH=
# mTLS için istemci CA'sı (SDK ↔ bulut karşılıklı doğrulama). Boşsa mTLS kapalı.
TLS_CLIENT_CA_PATH=

# --- Sağlayıcı API key'leri (Vault'tan çekilir, koda gömülmez) ---
DEEPGRAM_KEY=
DEEPL_KEY=
ELEVENLABS_KEY=

# --- Multistream OAuth istemci kimlikleri (Faz 1.6) ---
# Boşsa ilgili sağlayıcı "yapılandırılmamış" görünür; authorize 503 döner.
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=
CASTR_CLIENT_ID=
CASTR_CLIENT_SECRET=
STREAMLABS_CLIENT_ID=
STREAMLABS_CLIENT_SECRET=

# --- Altyapı / deploy (opsiyonel) ---
RAILWAY_TOKEN=
HETZNER_API_KEY=
